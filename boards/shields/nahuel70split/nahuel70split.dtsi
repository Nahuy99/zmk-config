#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout_0;
    };

    default_transform: keymap_transform0{
        compatible = "zmk,matrix-transform";

        columns = <16>;
        rows = <6>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)                     RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)                     RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)                     RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)     RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15)
        RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)     RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
                                                                RC(5,7)     RC(5,8)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 0
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 1
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 2
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 3
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 4
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 5
            ;
    };

    physical_layout_0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "LAYOUT";
        transform = <&default_transform>;

         keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  350    0       0     0     0>
            , <&key_physical_attrs 100 100 1475    5       0     0     0>
            , <&key_physical_attrs 100 100  250   25       0     0     0>
            , <&key_physical_attrs 100 100  450   25       0     0     0>
            , <&key_physical_attrs 100 100 1375   30       0     0     0>
            , <&key_physical_attrs 100 100 1575   30       0     0     0>
            , <&key_physical_attrs 100 100  150   50       0     0     0>
            , <&key_physical_attrs 100 100  550   50       0     0     0>
            , <&key_physical_attrs 100 100  650   50       0     0     0>
            , <&key_physical_attrs 100 100 1175   50       0     0     0>
            , <&key_physical_attrs 100 100 1675   50       0     0     0>
            , <&key_physical_attrs 100 100 1275   55       0     0     0>
            , <&key_physical_attrs 100 100  350  100       0     0     0>
            , <&key_physical_attrs 100 100 1475  105       0     0     0>
            , <&key_physical_attrs 100 100  450  125       0     0     0>
            , <&key_physical_attrs 100 100 1575  130       0     0     0>
            , <&key_physical_attrs 100 150  650  150       0     0     0>
            , <&key_physical_attrs 100 150 1175  150       0     0     0>
            , <&key_physical_attrs 100 100  350  200       0     0     0>
            , <&key_physical_attrs 100 100 1475  205       0     0     0>
            , <&key_physical_attrs 100 100  450  225       0     0     0>
            , <&key_physical_attrs 100 100 1575  230       0     0     0>
            , <&key_physical_attrs 100 100  350  300       0     0     0>
            , <&key_physical_attrs 100 150  650  300       0     0     0>
            , <&key_physical_attrs 100 150 1175  300       0     0     0>
            , <&key_physical_attrs 100 100 1475  305       0     0     0>
            , <&key_physical_attrs 100 100  450  325       0     0     0>
            , <&key_physical_attrs 100 100 1575  330       0     0     0>
            , <&key_physical_attrs 100 100  550  350       0     0     0>
            , <&key_physical_attrs 100 100 1275  355       0     0     0>
            , <&key_physical_attrs 100 100  550  150       0    25     0>
            , <&key_physical_attrs 100 100 1275  155       0    25     0>
            , <&key_physical_attrs 100 100  550  250       0    25     0>
            , <&key_physical_attrs 100 100 1275  255       0    25     0>
            , <&key_physical_attrs 150 100    0   50       0   225     0>
            , <&key_physical_attrs 150 100 1775   50       0   225     0>
            , <&key_physical_attrs 100 100  250  125       0   225     0>
            , <&key_physical_attrs 100 100 1375  130       0   225     0>
            , <&key_physical_attrs 150 100    0  150       0   225     0>
            , <&key_physical_attrs 100 100  150  150       0   225     0>
            , <&key_physical_attrs 100 100 1675  150       0   225     0>
            , <&key_physical_attrs 150 100 1775  150       0   225     0>
            , <&key_physical_attrs 100 100  250  225       0   225     0>
            , <&key_physical_attrs 100 100 1375  230       0   225     0>
            , <&key_physical_attrs 150 100    0  250       0   225     0>
            , <&key_physical_attrs 100 100  150  250       0   225     0>
            , <&key_physical_attrs 100 100 1675  250       0   225     0>
            , <&key_physical_attrs 150 100 1775  250       0   225     0>
            , <&key_physical_attrs 100 100  250  325       0   225     0>
            , <&key_physical_attrs 100 100 1375  330       0   225     0>
            , <&key_physical_attrs 150 100    0  350       0   225     0>
            , <&key_physical_attrs 100 100  150  350       0   225     0>
            , <&key_physical_attrs 100 100 1675  350       0   225     0>
            , <&key_physical_attrs 150 100 1775  350       0   225     0>
            , <&key_physical_attrs 100 100  350  400       0   225     0>
            , <&key_physical_attrs 100 100 1475  405       0   225     0>
            , <&key_physical_attrs 100 100  250  425       0   225     0>
            , <&key_physical_attrs 100 100  450  425       0   225     0>
            , <&key_physical_attrs 100 100 1375  430       0   225     0>
            , <&key_physical_attrs 100 100 1575  430       0   225     0>
            , <&key_physical_attrs 150 100    0  450       0   225     0>
            , <&key_physical_attrs 100 100  150  450       0   225     0>
            , <&key_physical_attrs 100 100 1675  450       0   225     0>
            , <&key_physical_attrs 150 100 1775  450       0   225     0>
            , <&key_physical_attrs 100 100  775  355    1500   675   350>
            , <&key_physical_attrs 100 100  875  355    1500   675   350>
            , <&key_physical_attrs 100 200  775  455    1500   675   350>
            , <&key_physical_attrs 100 100  875  455    1500   675   350>
            , <&key_physical_attrs 100 200  675  456    1500   675   350>
            , <&key_physical_attrs 100 100  875  555    1500   675   350>
            , <&key_physical_attrs 100 100  925  505 (-1500)   675   350>
            , <&key_physical_attrs 100 100 1025  505 (-1500)   675   350>
            , <&key_physical_attrs 100 100  925  605 (-1500)   675   350>
            , <&key_physical_attrs 100 200 1025  605 (-1500)   675   350>
            , <&key_physical_attrs 100 200 1125  605 (-1500)   675   350>
            , <&key_physical_attrs 100 100  925  705 (-1500)   675   350>
            ;
    };

    position_map {
        compatible = "zmk,physical-layout-position-map";

        default {
            physical-layout = <&physical_layout_0>;
            positions = <>;
        };
    };
};
