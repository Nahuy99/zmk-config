#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &bt BT_CLR_ALL &bt BT_CLR_ALL &kp N2  &kp N3 &kp N4 &kp N5 &kp N6                  &kp N7 &kp  N8   &kp  N9 &kp  N0  &kp MINUS &kp MINUS &kp MINUS
                &kp TAB  &kp Q  &kp W  &kp F  &kp P  &kp B  &kp N6            &kp J  &kp  L    &kp  U  &kp  Y   &kp LBKT  &kp LBKT  &kp LBKT
                &kp CLCK  &kp A  &kp R  &kp S  &kp T  &kp G  &kp N6         &kp M  &kp  M    &kp  N  &kp E &kp I   &kp O   &kp RET
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp D  &kp V  &kp N  &kp M      &kp COMMA &kp K &kp H &kp FSLH &kp COMMA &kp DOT &kp UP &kp FSLH
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M      &kp COMMA &kp DOT &kp UP &kp FSLH &kp COMMA &kp DOT &kp UP &kp FSLH
                                                                     &kp LCTRL  &kp LGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        raise {
            bindings = <
                &bt BT_CLR_ALL &bt BT_CLR_ALL &kp N2  &kp N3 &kp N4 &kp N5 &kp N6                  &kp N7 &kp  N8   &kp  N9 &kp  N0  &kp MINUS &kp MINUS &kp MINUS
                &kp TAB  &kp Q  &kp W  &kp F  &kp P  &kp B  &kp N6            &kp J  &kp  L    &kp  U  &kp  Y   &kp LBKT  &kp LBKT  &kp LBKT
                &kp CLCK  &kp A  &kp R  &kp S  &kp T  &kp G  &kp N6         &kp M  &kp  M    &kp  N  &kp E &kp I   &kp O   &kp RET
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp D  &kp V  &kp N  &kp M      &kp COMMA &kp K &kp H &kp FSLH &kp COMMA &kp DOT &kp UP &kp FSLH
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M      &kp COMMA &kp DOT &kp UP &kp FSLH &kp COMMA &kp DOT &kp UP &kp FSLH
                                                                     &kp LCTRL  &kp LGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
